<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igMaps="using:Infragistics.Controls.Maps"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=map}"
          DescriptionType="GeographicMap"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="Series[0 as GeographicTileSeries].TileImagery.ImageryStyle"
                  Name="ImageryStyle"
                  Label="Imagery Style"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Satellite">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igMaps:XamGeographicMap
          Name="map"
          Zoomable="true">
              <igMaps:XamGeographicMap.BackgroundContent>
                  <igMaps:AzureMapsImagery
                  Name="azureImagery"
                  ApiKey="REPLACE_WITH_AZURE_KEY"
                  ImageryStyle="Satellite">
                  </igMaps:AzureMapsImagery>
              </igMaps:XamGeographicMap.BackgroundContent>
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicTileSeries
                  Name="imagerySeries">
                      <igMaps:GeographicTileSeries.TileImagery>
                          <igMaps:AzureMapsImagery
                          Name="azureOverlay"
                          ApiKey="REPLACE_WITH_AZURE_KEY"
                          ImageryStyle="Satellite">
                          </igMaps:AzureMapsImagery>
                      </igMaps:GeographicTileSeries.TileImagery>
                  </igMaps:GeographicTileSeries>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
