<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igMaps="using:Infragistics.Controls.Maps"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igMaps:XamGeographicMap
          Name="geoMap"
          Zoomable="true">
              <igMaps:XamGeographicMap.Series>
                  <igMaps:GeographicShapeSeries
                  Name="polygonSeries"
                  ShapeMemberPath="Points"
                  ShapeFill="rgb(150, 150, 150)"
                  ShapeStroke="Black"
                  ShapeStrokeThickness="1">
                  </igMaps:GeographicShapeSeries>
                  <igMaps:GeographicPolylineSeries
                  Name="lineSeries"
                  ShapeMemberPath="Points"
                  ShapeStroke="rgba(147, 15, 180, 0.5)"
                  Thickness="3">
                  </igMaps:GeographicPolylineSeries>
                  <igMaps:GeographicSymbolSeries
                  Name="symbolSeries"
                  ItemsSource="{Binding WorldCities}"
                  LongitudeMemberPath="Longitude"
                  LatitudeMemberPath="Latitude"
                  MarkerType="Circle"
                  MarkerOutline="#0266c4"
                  MarkerBrush="white">
                  </igMaps:GeographicSymbolSeries>
              </igMaps:XamGeographicMap.Series>
          </igMaps:XamGeographicMap>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
