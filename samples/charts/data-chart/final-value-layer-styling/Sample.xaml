<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          Name="chart"
          Subtitle="Renewable Energy Generated">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding EnergyRenewableGeneration}"
                  Label="Year">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  Title="TWh"
                  LabelLocation="OutsideRight">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:LineSeries
                  Name="series1"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding EnergyRenewableGeneration}"
                  ValueMemberPath="America">
                  </igCharts:LineSeries>
                  <igCharts:FinalValueLayer
                  Name="crosshairLayer"
                  AxisAnnotationBackground="orange"
                  AxisAnnotationTextColor="black"
                  AxisAnnotationOutline="black">
                  </igCharts:FinalValueLayer>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
