<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          Name="chart"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericXAxis
                  Name="xAxis"
                  AbbreviateLargeNumbers="true"
                  TitleBottomMargin="10"
                  Title="Plane of Rotation (in Light Years)">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  AbbreviateLargeNumbers="true"
                  TitleBottomMargin="10"
                  Title="Plane of Rotation (in Light Years)">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:HighDensityScatterSeries
                  Name="series"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding ScatterHighDensityData}"
                  Title="Distribution"
                  XMemberPath="X"
                  YMemberPath="Y"
                  ShowDefaultTooltip="true"
                  MouseOverEnabled="true"
                  ProgressiveLoad="true"
                  HeatMinimumColor="black"
                  HeatMaximumColor="yellow"
                  HeatMaximum="1"
                  HeatMinimum="5"
                  Resolution="3">
                  </igCharts:HighDensityScatterSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
