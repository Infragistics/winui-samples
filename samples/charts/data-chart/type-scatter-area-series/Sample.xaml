<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          Name="chart"
          GridMode="BeforeSeries"
          IsHorizontalZoomEnabled="false"
          IsVerticalZoomEnabled="false">
              <igCharts:XamDataChart.Axes>
                  <igCharts:NumericXAxis
                  Name="xAxis1"
                  LabelLocation="OutsideLeft"
                  MinimumValue="-180"
                  MaximumValue="180"
                  Interval="30"
                  Title="Longitude">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis1"
                  LabelLocation="OutsideBottom"
                  MinimumValue="-90"
                  MaximumValue="90"
                  Interval="30"
                  Title="Latitude">
                  </igCharts:NumericYAxis>
                  <igCharts:NumericXAxis
                  Name="xAxis2"
                  LabelLocation="OutsideTop"
                  MinimumValue="-180"
                  MaximumValue="180"
                  Interval="30">
                  </igCharts:NumericXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis2"
                  LabelLocation="OutsideRight"
                  MinimumValue="-90"
                  MaximumValue="90"
                  Interval="30"
                  Title="Latitude">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:ScatterAreaSeries
                  Name="series"
                  XAxis="{Binding ElementName=xAxis1}"
                  YAxis="{Binding ElementName=yAxis1}"
                  ItemsSource="{Binding ScatterMagneticFieldData}"
                  XMemberPath="X"
                  YMemberPath="Y"
                  ColorMemberPath="Z"
                  ShowDefaultTooltip="true">
                      <igCharts:ScatterAreaSeries.ColorScale>
                          <igCharts:CustomPaletteColorScale
                          InterpolationMode="InterpolateHSV"
                          MinimumValue="-2"
                          MaximumValue="2"
                          Palette="#8670cb #4ac4ff #b5cc2e #fc8612 #ed4840">
                          </igCharts:CustomPaletteColorScale>
                      </igCharts:ScatterAreaSeries.ColorScale>
                  </igCharts:ScatterAreaSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
