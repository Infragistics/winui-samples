<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Sample"
    xmlns:ig="using:Infragistics.Controls"
    xmlns:igCharts="using:Infragistics.Controls.Charts"
    xmlns:igLayouts="using:Infragistics.Controls.Layouts"
    mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <Grid>
          <igLayouts:XamPropertyEditorPanel
          ComponentRenderer="{Binding Renderer}"
          Target="{Binding ElementName=chart}"
          DescriptionType="DataChart"
          IsHorizontal="true"
          IsWrappingEnabled="true"
          Name="propertyEditorPanel1">
              <igLayouts:XamPropertyEditorPanel.Properties>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="PanUp"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Pan Up"
                  ButtonClicked="EditorButtonChartPanUp"
                  Name="propertyEditorPropertyDescription1">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="PanDown"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Pan Down"
                  ButtonClicked="EditorButtonChartPanDown"
                  Name="propertyEditorPropertyDescription2">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="PanLeft"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Pan Left"
                  ButtonClicked="EditorButtonChartPanLeft"
                  Name="propertyEditorPropertyDescription3">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="PanRight"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Pan Right"
                  ButtonClicked="EditorButtonChartPanRight"
                  Name="propertyEditorPropertyDescription4">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ZoomIn"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Zoom In"
                  ButtonClicked="EditorButtonChartZoomIn"
                  Name="propertyEditorPropertyDescription5">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="ZoomOut"
                  Label=""
                  ValueType="Button"
                  PrimitiveValue="Zoom Out"
                  ButtonClicked="EditorButtonChartZoomOut"
                  Name="propertyEditorPropertyDescription6">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="PanModifier"
                  Name="PanModifier"
                  Label="Pan Modifier"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames1}"
                  DropDownValues="{Binding dropDownValues1}"
                  PrimitiveValue="Alt">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="DragModifier"
                  Name="DragModifier"
                  Label="Zoom Modifier"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames2}"
                  DropDownValues="{Binding dropDownValues2}"
                  PrimitiveValue="Shift">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="DefaultInteraction"
                  Name="DefaultInteraction"
                  Label="Interaction"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="EnumValue"
                  DropDownNames="{Binding dropDownNames3}"
                  DropDownValues="{Binding dropDownValues3}"
                  PrimitiveValue="DragPan">
                  </igLayouts:PropertyEditorPropertyDescription>
                  <igLayouts:PropertyEditorPropertyDescription
                  PropertyPath="IsHorizontalZoomEnabled"
                  Name="IsHorizontalZoomEnabled"
                  Label="Zooming"
                  ShouldOverrideDefaultEditor="true"
                  ValueType="Boolean"
                  PrimitiveValue="true">
                  </igLayouts:PropertyEditorPropertyDescription>
              </igLayouts:XamPropertyEditorPanel.Properties>
          </igLayouts:XamPropertyEditorPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" x:Name="ContentRoot">
          <igCharts:XamDataChart
          Name="chart"
          Subtitle="Stock Prices Series in Candlestick Display Type"
          SubtitleTopMargin="10"
          IsHorizontalZoomEnabled="true"
          IsVerticalZoomEnabled="true"
          PanModifier="Alt"
          DragModifier="Shift"
          DefaultInteraction="DragPan">
              <igCharts:XamDataChart.Axes>
                  <igCharts:CategoryXAxis
                  Name="xAxis"
                  ItemsSource="{Binding StockTesla}"
                  Label="Date">
                  </igCharts:CategoryXAxis>
                  <igCharts:NumericYAxis
                  Name="yAxis"
                  Title="Amount (in USD)"
                  TitleRightMargin="10"
                  LabelRightMargin="10"
                  LabelHorizontalAlignment="Left"
                  LabelLocation="OutsideRight">
                  </igCharts:NumericYAxis>
              </igCharts:XamDataChart.Axes>
              <igCharts:XamDataChart.Series>
                  <igCharts:FinancialPriceSeries
                  Name="priceSeries"
                  XAxis="{Binding ElementName=xAxis}"
                  YAxis="{Binding ElementName=yAxis}"
                  ItemsSource="{Binding StockTesla}"
                  DisplayType="Candlestick"
                  OpenMemberPath="Open"
                  CloseMemberPath="Close"
                  HighMemberPath="High"
                  LowMemberPath="Low"
                  VolumeMemberPath="Volume"
                  ShowDefaultTooltip="true"
                  IsTransitionInEnabled="true"
                  Title="Price">
                  </igCharts:FinancialPriceSeries>
              </igCharts:XamDataChart.Series>
          </igCharts:XamDataChart>
        </Grid>
      </Grid>
    </Grid>
</UserControl>
