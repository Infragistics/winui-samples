<UserControl
    x:Class="Sample.Sample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ig="using:Infragistics.Controls"
        xmlns:igCharts="using:Infragistics.Controls.Charts"
                            xmlns:igLayouts="using:Infragistics.Controls.Layouts"
            mc:Ignorable="d">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel>
                        <Grid>
          <igCharts:XamDataLegend
          Name="legend"
          Target="{Binding ElementName=chart}"
          ValueFormatString="{}{0} Billion">
              <igCharts:XamDataLegend.ValueFormatSpecifiers>
                  <igCharts:NumberFormatSpecifier
                  Style="currency"
                  Currency="USD"
                  CurrencyDisplay="symbol"
                  MaximumFractionDigits="2"
                  MinimumFractionDigits="2">
                  </igCharts:NumberFormatSpecifier>
              </igCharts:XamDataLegend.ValueFormatSpecifiers>
          </igCharts:XamDataLegend>
        </Grid>
                              </StackPanel>
      <Grid Grid.Row="1">
        <igCharts:XamCategoryChart
        Name="chart"
        ItemsSource="{Binding HighestGrossingMovies}"
        ChartType="Column"
        IsHorizontalZoomEnabled="false"
        IsVerticalZoomEnabled="false"
        FinalValueAnnotationsPrecision="2"
        DataToolTipValueFormatString="{}{0} Billion"
        YAxisLabelFormat="{}{0}B">
            <igCharts:XamCategoryChart.DataToolTipValueFormatSpecifiers>
                <igCharts:NumberFormatSpecifier
                Style="currency"
                Currency="USD"
                CurrencyDisplay="symbol"
                MaximumFractionDigits="2"
                MinimumFractionDigits="2">
                </igCharts:NumberFormatSpecifier>
            </igCharts:XamCategoryChart.DataToolTipValueFormatSpecifiers>
            <igCharts:XamCategoryChart.YAxisLabelFormatSpecifiers>
                <igCharts:NumberFormatSpecifier
                Style="currency"
                Currency="USD"
                CurrencyDisplay="symbol"
                MinimumFractionDigits="0">
                </igCharts:NumberFormatSpecifier>
            </igCharts:XamCategoryChart.YAxisLabelFormatSpecifiers>
        </igCharts:XamCategoryChart>
      </Grid>
    </Grid>
</UserControl>
