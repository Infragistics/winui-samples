<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SamplesBrowser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" PrivateAssets="all" />
  </ItemGroup>
  <!-- Assets included as content files -->
  <ItemGroup>
    <Content Include="Assets\toc.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Label="IngestedSamples">
    <Page Include="Pages\charts\category-chart\animation\Sample.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Pages\charts\category-chart\animation\Sample.xaml.cs">
      <DependentUpon>Sample.xaml</DependentUpon>
    </Compile>
    <Page Include="Pages\charts\category-chart\overview\Sample.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Pages\charts\category-chart\overview\Sample.xaml.cs">
      <DependentUpon>Sample.xaml</DependentUpon>
    </Compile>
    <Page Include="Pages\gauges\radial-gauge\overview\Sample.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Pages\gauges\radial-gauge\overview\Sample.xaml.cs">
      <DependentUpon>Sample.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>