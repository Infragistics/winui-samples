<Page
    x:Class="SamplesBrowser.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="800">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE9F9;" FontSize="40"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="IG WinUI Samples"
                           Style="{StaticResource TitleLargeTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock
                Text="Welcome to the Infragistics WinUI Samples Browser."
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap"/>

            <TextBlock
                Text="Use the navigation panel on the left to browse samples organized by component. Click on a component to expand it, then click a sample to view it."
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"/>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Getting Started"
                Message="Select a sample from the navigation menu on the left to get started."/>

            <TextBlock
                Text="About the Samples"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="These samples are generated from the igniteui-xplat-examples repository. Each sample is also independently buildable from its own project in the samples/ folder."
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>

</Page>
